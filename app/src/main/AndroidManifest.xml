<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Autostart nach Neustart (BootReceiver) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Direkter Dialog „Akku-Optimierung ignorieren“ (statt Umweg über die Einstellungsliste) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- GitHub GraphQL API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Berechtigung, über anderen Apps zu zeichnen (Notch-Overlay) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground-Service, damit das Overlay dauerhaft läuft -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Ab Android 13 nötig, um die Foreground-Service-Benachrichtigung anzuzeigen -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Benachrichtigungszugriff (Mediaplayer-Steuerung): BIND_NOTIFICATION_LISTENER_SERVICE
        ist eine System-Berechtigung und wird NICHT per uses-permission angefordert, sondern
        nur am Listener-Service unten deklariert. Der Nutzer erteilt den Zugriff manuell unter
        Einstellungen > Benachrichtigungszugriff.
    -->

    <!-- Paketsichtbarkeit (Android 11+) für die Dev-Shortcuts: Termux und GitHub Mobile starten. -->
    <queries>
        <package android:name="com.termux" />
        <package android:name="com.github.android" />
        <!-- Projekt-Shortcuts: installierte Apps mit Launcher-Icon zur Auswahl anbieten -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".DevNotchApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DevNotch">

        <service
            android:name=".service.NotchOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Pflichtangabe für specialUse ab Android 14 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent dynamic notch overlay showing media controls and status" />
        </service>

        <service
            android:name=".service.MediaNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Nur geschützte System-Broadcasts, daher nicht exportiert -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Notiz-Export: .md-Dateien für ACTION_SEND freigeben -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>

        <!-- Unsichtbar: öffnet „Speichern unter…“ (Drive/lokal) für den Overlay-Service -->
        <activity
            android:name=".feature.notes.ExportNoteActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
