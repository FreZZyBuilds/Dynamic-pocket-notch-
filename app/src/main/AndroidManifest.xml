<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Berechtigung, über anderen Apps zu zeichnen (Notch-Overlay) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground-Service, damit das Overlay dauerhaft läuft -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Ab Android 13 nötig, um die Foreground-Service-Benachrichtigung anzuzeigen -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Benachrichtigungszugriff (Mediaplayer-Steuerung): BIND_NOTIFICATION_LISTENER_SERVICE
        ist eine System-Berechtigung und wird NICHT per uses-permission angefordert, sondern
        nur am Listener-Service unten deklariert. Der Nutzer erteilt den Zugriff manuell unter
        Einstellungen > Benachrichtigungszugriff.
    -->

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DevNotch">

        <service
            android:name=".service.NotchOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Pflichtangabe für specialUse ab Android 14 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent dynamic notch overlay showing media controls and status" />
        </service>

        <service
            android:name=".service.MediaNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
