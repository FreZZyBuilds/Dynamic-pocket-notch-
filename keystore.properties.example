# Kopieren nach keystore.properties (wird von git ignoriert) und ausfüllen.
# Keystore erzeugen:
#   keytool -genkeypair -v -keystore devnotch-release.jks -alias devnotch \
#           -keyalg RSA -keysize 4096 -validity 10000
# Alternativ in CI: DEVNOTCH_KEYSTORE_FILE, DEVNOTCH_KEYSTORE_PASSWORD,
#                   DEVNOTCH_KEY_ALIAS, DEVNOTCH_KEY_PASSWORD
storeFile=devnotch-release.jks
storePassword=CHANGE_ME
keyAlias=devnotch
keyPassword=CHANGE_ME
